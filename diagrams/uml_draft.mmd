classDiagram
    direction LR

    class Owner {
        +name: str
        +available_minutes: int
        +preferences: List~str~
        +pets: List~Pet~
        +add_pet(pet)
    }

    class Pet {
        +name: str
        +species: str
        +tasks: List~Task~
        +add_task(task)
        +remove_task(title)
    }

    class Task {
        +title: str
        +duration_minutes: int
        +priority: str
        +edit(duration_minutes, priority)
    }

    class Scheduler {
        +generate_plan(owner, pet) List~Task~
        +explain_plan(plan) str
    }

    Owner "1" --> "1..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler ..> Owner : reads time + preferences
    Scheduler ..> Pet : reads tasks
