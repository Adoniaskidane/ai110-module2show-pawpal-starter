classDiagram
    direction LR

    class Owner {
        +name: str
        +available_minutes: int
        +day_start_minute: int
        +preferences: List~str~
        +pets: List~Pet~
        +add_pet(pet)
        +get_all_tasks() List~Tuple~Pet, Task~~
    }

    class Pet {
        +name: str
        +species: str
        +tasks: List~Task~
        +add_task(task)
        +remove_task(title)
    }

    class Task {
        +title: str
        +duration_minutes: int
        +priority: str
        +frequency: str
        +completed: bool
        +edit(duration_minutes, priority)
        +mark_complete()
    }

    class ScheduledTask {
        +task: Task
        +pet: Pet
        +start_minute: int
        +end_minute() int
        +start_time() str
    }

    class Scheduler {
        +generate_plan(owner, pet) List~ScheduledTask~
        +explain_plan(plan) str
    }

    Owner "1" --> "1..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler ..> Owner : reads time + preferences
    Scheduler ..> Pet : reads tasks
    Scheduler ..> ScheduledTask : creates
    ScheduledTask --> Task : places
    ScheduledTask --> Pet : for
